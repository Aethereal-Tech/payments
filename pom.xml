<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.aetherealtech</groupId>
    <artifactId>payments</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Aethereal Payments (parent)</name>
    <description>A provider-neutral payments SPI for Java, with Bankart and AgentaOS adapters.</description>
    <url>https://github.com/Aethereal-Tech/payments</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Aethereal-Tech/payments.git</connection>
        <url>https://github.com/Aethereal-Tech/payments</url>
    </scm>

    <!-- Three artifacts, one repository, one version, one release. The split is about the DEPENDENCY,
         not about tidiness: `payments-core` and `payments-agentaos` have zero runtime dependencies and
         `payments-bankart` has one (Jackson 2). Merging them would put Jackson 2 on the classpath of a
         consumer that only ever talks to AgentaOS — and at least one of them runs Jackson 3, where an
         unwanted Jackson 2 is not a version conflict Maven can mediate but a second, differently-named
         library nobody asked for.

         Splitting them at the VERSION instead — three release trains — would let a consumer resolve
         payments-core:0.3.0 against payments-bankart:0.1.0 and meet the mismatch as a NoSuchMethodError
         at the first webhook. All three are published from the same commit at the same number precisely
         so that cannot happen. -->
    <modules>
        <module>payments-core</module>
        <module>payments-bankart</module>
        <module>payments-agentaos</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Consumers need JDK 25 or newer. `release` (not source/target) is what also checks every
             call against the Java 25 API, so the bytecode version and the API surface cannot disagree.
             Current language features are in scope here by choice, not by accident. -->
        <maven.compiler.release>25</maven.compiler.release>

        <jackson.version>2.22.2</jackson.version>
        <junit.version>5.14.4</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <wiremock.version>3.13.2</wiremock.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The JUnit BOM, imported rather than pinned one artifact at a time: a test dependency
                 that brings its OWN JUnit is how the platform ends up misaligned, and the launcher's
                 answer to that is to discover no tests at all rather than to fail loudly. The BOM pins
                 the whole family — jupiter 5.x and platform 1.x move together. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>net.aetherealtech</groupId>
                <artifactId>payments-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- The Jackson BOM, for the same reason as the JUnit one above and learned the same
                 painful way: pinning `jackson-databind` ALONE while WireMock drags in its own
                 `jackson-annotations` and `jackson-core` produced databind 2.22.2 against annotations
                 2.20, and the first WireMock stub failed with
                 `NoClassDefFoundError: com/fasterxml/jackson/annotation/JsonSerializeAs` — a class
                 that exists in 2.22 and not in 2.20. Nearest-wins mediation cannot see that the two
                 are one library; the BOM pins the whole family so they move together.

                 It is `dependencyManagement`, so it constrains versions without adding anything to a
                 classpath: `payments-agentaos` and `payments-core` still resolve zero Jackson at
                 compile or runtime, and only `payments-bankart` actually depends on it. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Aethereal-Tech/payments</url>
        </repository>
    </distributionManagement>
</project>
